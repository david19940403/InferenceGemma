            "Application"
          ]
        },
        "hours": {
          "type": "string",
          "description": "Horas anteriores, 1 a 168",
          "default": "24"
        },
        "limit": {
          "type": "string",
          "description": "Maximo de eventos, 1 a 10",
          "default": "3"
        }
      },
      "required": []
    },
    "effect": "read"
  },
